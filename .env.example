# RML Construction Supply - Environment Configuration
# Copy this file to .env in the project root and configure your values.

# Flask Session Security Key
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Optional Custom Database File Path (defaults to database/rml_database.db)
# DATABASE_PATH=database/rml_database.db

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
